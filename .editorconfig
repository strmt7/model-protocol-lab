# Editor hints (cycle 210). Ruff enforces formatting in CI; this file
# only tells a contributor's editor the same conventions so files
# arrive pre-formatted. It never overrides CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces are meaningful in Markdown (hard line breaks).
trim_trailing_whitespace = false
